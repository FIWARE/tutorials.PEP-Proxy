        {\"name\": \"description\", \"type\":\"Property\", \"value\": \"Temperature Sensor\"},
        {\"name\": \"category\", \"type\":\"Property\", \"value\": [\"sensor\"]},
        {\"name\": \"controlledProperty\", \"type\": \"Property\", \"value\": \"temperature\"},
        {\"name\": \"supportedProtocol\", \"type\": \"Property\", \"value\": [\"json\"]}
      ]
   },
   {
