   {
     \"apikey\":      \"321701236\",
     \"cbroker\":     \"${CBROKER}\",
     \"trust\":       \"${TRUST_TOKEN}\",
     \"entity_type\": \"TemperatureSensor\",
     \"resource\":    \"/iot/json\",
     \"protocol\":    \"PDI-IoTA-JSON\",
     \"transport\":   \"HTTP\",
     \"timezone\":    \"Europe/Berlin\",
     \"attributes\": [
       { \"object_id\": \"t\", \"name\":\"temperature\", \"type\": \"Integer\",
         \"metadata\": {\"unitCode\": {\"type\": \"Property\",\"value\": \"CEL\"}}
       }
      ],
