#!/bin/bash
#
#  curl commands to reload the data from the previous tutorial
#

set -e

####################################################
#
# Fetch a Keycloak offline token for the IoT Agent service account.
# This refresh_token (with offline_access scope) is used as the "trust"
# field in each service group — the IoT Agent exchanges it for an
# access_token before each request to the Context Broker via APISIX.
#
####################################################

printf "⏳ Fetching Keycloak offline token for IoT Agent trust... "

TOKEN_RESPONSE=$(curl -s -X POST \
  'http://keycloak:8080/realms/farm-management/protocol/openid-connect/token' \
  -H 'Content-Type: application/x-www-form-urlencoded' \
  --data-urlencode 'grant_type=password' \
  --data-urlencode 'username=bob' \
  --data-urlencode 'password=test' \
  --data-urlencode 'client_id=ngsi-ld-farm' \
  --data-urlencode 'client_secret=1234' \
  --data-urlencode 'scope=openid offline_access')

TRUST_TOKEN=$(echo "${TOKEN_RESPONSE}" | grep -o '"refresh_token":"[^"]*"' | cut -d'"' -f4)

if [ -z "${TRUST_TOKEN}" ]; then
  printf "\n\033[1;31mERROR: Failed to obtain offline/refresh token from Keycloak\033[0m\n"
  echo "Response: ${TOKEN_RESPONSE}"
  exit 1
fi

printf "\033[1;32mdone\033[0m\n"

printf "⏳ Provisioning IoT devices "

#
# IOTA_CB_PATH is set by the broker-specific docker-compose overlay (e.g. /data/orion).
# The cbroker field in service groups must match the full APISIX URL for that broker.
# We read it from the environment variable IOTA_CB_PATH, defaulting to /data/orion.
#
CB_PATH="${IOTA_CB_PATH:-/data/orion}"
CBROKER="http://apisix:${APISIX_PORT:-9080}${CB_PATH}"

#
# Create service groups for all IoT devices
#

curl -s -o /dev/null -X POST \
  'http://iot-agent:4041/iot/services' \
  -H 'Content-Type: application/json' \
  -H 'fiware-service: openiot' \
  -H 'fiware-servicepath: /' \
  -d "{
